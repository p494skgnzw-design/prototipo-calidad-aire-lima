# Si se define, POST /api/ingest exige Authorization: Bearer <token>.
# Déjelo vacío en el prototipo local.
INGEST_TOKEN=

# Origen permitido para el navegador, solo si un cliente web externo
# publica lecturas. El puente MQTT no lo necesita.
# INGEST_CORS_ORIGIN=https://ejemplo.org

# Intervalo del flujo en vivo, en milisegundos (1000–60000).
SIM_INTERVAL_MS=4000
